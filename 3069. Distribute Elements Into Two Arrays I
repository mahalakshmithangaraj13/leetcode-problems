class Solution {
    public int[] resultArray(int[] nums){
        int[] arr1=new int[nums.length];
        int[] arr2=new int[nums.length];
        int j=0,k=0;
        for(int i=0;i<nums.length;i++){
            if(i==0){
               arr1[j]=nums[i];
               j++;
            }
            else if(i==1){
                arr2[k]=nums[i];
                k++;
            }
            else{
                if(arr1[j-1]>arr2[k-1]){
                   arr1[j]=nums[i];
                   j++;
                }
                else{
                   arr2[k]=nums[i];
                   k++;
                }
            }
        }
        for(int i=0;i<k;i++){
            arr1[j]=arr2[i];
            j++;
        }
        return arr1;
    }
}
